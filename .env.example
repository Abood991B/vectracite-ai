# Application Settings
PROJECT_NAME="VectraCite-AI"
VERSION="1.0.0"

# API Security (required for shared/production deployments)
AUTH_REQUIRED=true
API_READ_KEY="replace-with-a-long-random-read-key"
API_ADMIN_KEY="replace-with-a-distinct-long-random-admin-key"
CORS_ALLOWED_ORIGINS="http://localhost:8080"

# Ingestion resource limits
MAX_PDF_BYTES=26214400
MAX_PDF_PAGES=500
MAX_STRUCTURED_PAGES=500
MAX_STRUCTURED_TEXT_CHARS=2000000
INGEST_TIMEOUT_SECONDS=120
MAX_REQUEST_BYTES=0
MAX_RENDERED_PDF_PAGES=5000
REQUIRE_REDIS=false

# Qdrant Vector Database (set QDRANT_IN_MEMORY=true for serverless/local test mode)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="financebench_hybrid_v1"
QDRANT_IN_MEMORY=false
INDEX_SYNC_SECONDS=15
ALLOW_QDRANT_FALLBACK=false
# The runtime collection name is namespaced by embedding model and backend.
QDRANT_UPSERT_BATCH_SIZE=256
HYBRID_DENSE_WEIGHT=0.95
HYBRID_BM25_WEIGHT=0.05

# Parser/chunker configuration (the committed corpus cache is keyed by these)
PARSER_CHUNK_SIZE=1200
PARSER_CHUNK_OVERLAP=200

# Optional OCR for image-only pages. Native text extraction remains the fast path.
OCR_ENABLED=false
OCR_ENGINE="auto"
OCR_DPI=200
OCR_MIN_CHARS=30
OCR_MAX_PAGES=50
OCR_LANGUAGES="en"
OCR_REMOTE_URL=""
OCR_TIMEOUT_SECONDS=120
OCR_PADDLE_DET_MODEL="PP-OCRv5_mobile_det"
OCR_PADDLE_REC_MODEL="en_PP-OCRv5_mobile_rec"

# Embedding & Cross-Encoder Reranker Models (Hugging Face BAAI)
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIM=384
RERANKER_MODEL="BAAI/bge-reranker-base"
RERANKER_GATE="adaptive"
RERANKER_CONFIDENCE_THRESHOLD=0.5

# Redis Semantic Cache
REDIS_URL="redis://localhost:6379/0"
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=86400

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI="http://localhost:5000"
MLFLOW_EXPERIMENT_NAME="VectraCite-FinanceBench-Evaluation"

# Unified LLM Inference Endpoint (Self-Hosted vLLM or OpenAI-Compatible API)
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="EMPTY"
LLM_MODEL_NAME="meta-llama/Llama-3.1-8B-Instruct"
LLM_REMOTE_ENABLED=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
